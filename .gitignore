# ===== 秘密情報（NFR-04: 秘密情報はGitに保存しない） =====
.env
.env.*
# 共有用のサンプル設定ファイルはコミット対象にする
!.env.example

# ===== Node.js / フロントエンド（React + Vite） =====
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Python / バックエンド（FastAPI） =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== データベース =====
# MySQL のデータはDockerボリュームで永続化する（NFR-07）ため、ローカルのデータディレクトリやダンプは管理しない
mysql-data/
*.sql.gz
backup/

# ===== ログ =====
logs/
*.log

# ===== OS・エディタ =====
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
