# このファイルをコピーして .env を作成してください（cp .env.example .env）
# .env は Git にコミットしないでください（NFR-04）。
# 下記の値はローカル開発用のダミーです。公開環境では必ず別の値に変更してください。

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=osushi
MYSQL_USER=osushi
MYSQL_PASSWORD=change-me

# ===== ホスト側の公開ポート（他のアプリと重なる場合だけ変更） =====
DB_PORT=3307
BACKEND_PORT=8000
FRONTEND_PORT=5173
